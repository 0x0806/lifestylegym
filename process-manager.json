{
  "apps": [
    {
      "name": "lifestyle-gym",
      "script": "index.js",
      "instances": "max",
      "exec_mode": "cluster",
      "watch": false,
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "production",
        "PORT": 5000
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 5000,
        "FRONTEND_URL": "https://newlifestylegym.ae"
      },
      "error_file": "/var/www/lifestyle-gym/logs/err.log",
      "out_file": "/var/www/lifestyle-gym/logs/out.log",
      "log_file": "/var/www/lifestyle-gym/logs/combined.log",
      "time": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "kill_timeout": 5000,
      "wait_ready": true,
      "listen_timeout": 10000,
      "shutdown_with_message": true,
      "readiness_probe": {
        "http": {
          "url": "http://localhost:5000/api/health",
          "method": "GET",
          "expected_status": 200
        }
      },
      "post_update": [
        "npm install --production"
      ]
    }
  ]
}