# Files and directories to exclude from deployment

# Git
.git
.gitignore

# Node modules
node_modules

# Logs
logs
*.log

# Environment files (except production)
.env
.env.development
.env.test
!env.production

# Dependencies (will be installed on server)
package-lock.json
yarn.lock

# Documentation
README.md
docs/
*.md

# Development files
.nyc_output
coverage
.eslintcache
.vscode
.idea

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Docker files (will be copied separately)
Dockerfile
docker-compose.yml
docker-compose.override.yml

# Deployment files
deploy.sh
.deployignore

# Backup files
*.bak
*.backup
*.old

# Test files
test/
tests/
__tests__/
*.test.js
*.spec.js

# Build artifacts
build/
dist/
.next

# SSL certificates (should be on server)
ssl/
*.pem
*.key
*.crt
*.csr

# Cache
.cache
.parcel-cache

# Local configuration
.env.local
.env.*.local