# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://newlifestylegym.ae

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-production-email@gmail.com
SMTP_PASS=your-production-app-password

# Security Configuration
SESSION_SECRET=your-super-secure-session-secret-key-change-this-in-production
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FORM_RATE_LIMIT_HOURS=1
FORM_RATE_LIMIT_MAX=5

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/var/www/lifestyle-gym/uploads

# Analytics and Monitoring
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here

# CAPTCHA Configuration
CAPTCHA_SECRET=production-captcha-secret-key-change-this
CAPTCHA_EXPIRY=300000

# Web Push Configuration
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=your-production-email@gmail.com

# Database Configuration (if needed later)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifestylegym_prod
DB_USER=postgres
DB_PASSWORD=your-secure-database-password

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/www/lifestyle-gym/logs/app.log

# SSL Certificate Paths (for Node.js if needed)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=me-south-1

# Monitoring and Alerting
HEALTH_CHECK_ENABLED=true
MONITORING_ENABLED=true
ALERT_EMAIL=admin@newlifestylegym.ae
PERFORMANCE_MONITORING=true

# Security Headers
HELMET_ENABLED=true
CORS_ORIGIN=https://newlifestylegym.ae
TRUST_PROXY=true

# Cache Configuration
CACHE_TTL=3600
STATIC_CACHE_TTL=86400

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We are currently performing maintenance. Please check back soon."