{
  "name": "lifestylegym",
  "version": "1.0.0",
  "description": "New Lifestyle Gym - Professional fitness website with booking system",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build": "echo 'Build process placeholder'",
    "prod": "NODE_ENV=production node index.js",
    "pm2:start": "pm2 start process-manager.json",
    "pm2:stop": "pm2 stop lifestyle-gym",
    "pm2:restart": "pm2 restart lifestyle-gym",
    "pm2:logs": "pm2 logs lifestyle-gym",
    "pm2:monit": "pm2 monit",
    "docker:build": "docker build -t lifestyle-gym .",
    "docker:run": "docker run -p 5000:5000 lifestyle-gym",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "performance:test": "node --inspect index.js",
    "optimize:images": "echo 'Image optimization placeholder'",
    "analyze:bundle": "echo 'Bundle analysis placeholder'",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "health": "curl -f http://localhost:5000/api/health || exit 1",
    "pre-deploy": "npm run lint && npm test && npm run security:audit",
    "deploy": "./deploy.sh",
    "backup": "echo 'Backup process placeholder'"
  },
  "keywords": ["gym", "fitness", "sharjah", "personal-training", "booking"],
  "author": "New Lifestyle Gym",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0",
    "@types/node": "^22.13.11",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "nodemailer": "^6.9.8",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dompurify": "^3.0.5",
    "winston": "^3.11.0",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "redis": "^4.6.10",
    "sharp": "^0.32.6",
    "web-push": "^3.6.5",
    "xml2js": "^0.6.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "@types/jest": "^29.5.8",
    "cypress": "^13.6.0",
    "lighthouse": "^11.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
